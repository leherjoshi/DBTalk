# Google Gemini API Configuration
# Get your free API key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Database Configuration
DATABASE_URL=sqlite:///./data/olist.db

# Vector Store Configuration
CHROMA_PERSIST_DIR=./chroma_store

# Logging
LOG_LEVEL=INFO

# CORS Configuration
# Comma-separated list of allowed CORS origins. Use "*" for local dev only.
# In production set this to your actual domain, e.g.: https://yourdomain.com
ALLOWED_ORIGINS=*

# Legacy OpenAI Configuration (optional, if you want to switch back)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# EMBEDDING_MODEL=text-embedding-3-small
